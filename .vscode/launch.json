{
    // Debug configurations for the reorganized repository.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceRoot}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceRoot}"
        },
        {
            "name": "main.py (cuba sample)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceRoot}/main.py",
            "args": ["resources/example-cuba.png", "--quiet"],
            "console": "integratedTerminal",
            "cwd": "${workspaceRoot}"
        },
        {
            "name": "pytest (all)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "console": "integratedTerminal",
            "cwd": "${workspaceRoot}"
        },
        {
            "name": "run current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceRoot}"
        }
    ]
}
